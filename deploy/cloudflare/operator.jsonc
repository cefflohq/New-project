// PRODUCTION operator.cefflo.com -> operator (Founder domain map 2026-10-05). Prepared, NOT deployed.
// Deploy only via scripts/deploy-production.mjs after Founder approval;
// attaching the custom domain creates its Cloudflare DNS record.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cefflo-prod-operator",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "../../dist-surfaces/operator",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "operator.cefflo.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
}
