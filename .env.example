# Required environment identity. Never defaults to Production.
CEFFLO_ENVIRONMENT=local
CEFFLO_SUPABASE_PROJECT_REF=local

# Public browser configuration. Local values are printed by `npm run supabase:status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key

# Database test configuration. Mutation requires both flags and a positively
# identified disposable non-production target.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CEFFLO_DISPOSABLE_TARGET=1
CEFFLO_ALLOW_MUTATING_TESTS=1

# Hosted staging/test example (never commit the real DATABASE_URL):
# CEFFLO_ENVIRONMENT=staging
# CEFFLO_SUPABASE_PROJECT_REF=your-20-character-ref
# SUPABASE_URL=https://your-20-character-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-hosted-publishable-key
# DATABASE_URL=postgresql://postgres.your-20-character-ref:password@region.pooler.supabase.com:5432/postgres
# CEFFLO_DISPOSABLE_TARGET=1
# CEFFLO_ALLOW_MUTATING_TESTS=1
