# Template only -- copy this file to .env.staging and fill in the real
# values there. .env.staging is covered by .gitignore's `.env.*` pattern
# (the same rule that already protects .env) and will never be committed;
# this .example file is the only one tracked, and it holds no secrets.
#
# Usage (loads these into your current shell only):
#   set -a; source .env.staging; set +a
#
# Do NOT put the real password inline in DATABASE_URL if you can avoid it --
# prefer pulling it from your own local secret store at source-time. If you
# do put it here, .env.staging still never leaves your machine (gitignored),
# but treat the file itself as sensitive (chmod 600, don't paste it anywhere).

CEFFLO_ENVIRONMENT=staging
CEFFLO_SUPABASE_PROJECT_REF=tomvvmwktehexwhktenw
SUPABASE_URL=https://tomvvmwktehexwhktenw.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-staging-publishable-key

# region/host verified this session: aws-0-ap-south-1.pooler.supabase.com
DATABASE_URL=postgresql://postgres.tomvvmwktehexwhktenw:your-staging-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Only export these two when you actually intend to mutate staging for a
# specific, deliberate test run -- do not leave them set by default.
# CEFFLO_DISPOSABLE_TARGET=1
# CEFFLO_ALLOW_MUTATING_TESTS=1
