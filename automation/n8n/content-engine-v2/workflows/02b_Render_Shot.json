    {
      "id": "ce2WF02bRenderSh-11",
      "name": "Screen clip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1720,
        -260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const $json = $input.first().json;\nconst c = $('Config').first().json.config; const path = c.screens[$json.screen_id] || c.screens.vendor_orders;\nreturn [{ json: { n: $json.n, seconds: $json.seconds, subtitle: $json.subtitle, audio_url: $json.audio_url, video_url: c.render.url + path, provider: 'screen-library' } }];"
      }
