    {
      "id": "ce2WF02bRenderSh-12",
      "name": "Keyframe request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1720,
        60
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const $json = $input.first().json;\nconst c = $('Config').first().json.config;\nconst prompt = 'Vertical 9:16 photo taken on a phone, handheld, natural indoor light, candid, everyday Malaysian setting. Kak Zee (same woman as reference images), Malay woman mid-30s, wearing ' + c.image.wardrobe + '. ' + $json.visual_prompt + '. Not cinematic, not studio, natural skin texture, no text, no logos.';\nreturn [{ json: { ...$json, kf: { model: c.image.model, prompt, reference_images: c.image.personaRefs, size: '1080x1920', n: 1 } } }];"
      }
    },
