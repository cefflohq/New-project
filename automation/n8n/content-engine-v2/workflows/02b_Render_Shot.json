        "jsCode": "const $json = $input.first().json;\nconst prev = $('Wait 20s (Seedance)').first().json; const st = $json.status;\nreturn [{ json: { ...prev, tries: prev.tries + 1, status: st, done: st === 'succeeded', failed: st === 'failed' || st === 'cancelled' || prev.tries >= 30,\n  video_url: $json.content?.video_url || null } }];"
