    {
      "id": "ce2WF02bRenderSh-23",
      "name": "B-roll result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3940,
        -160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const $json = $input.first().json;\nconst s = $json; return [{ json: { n: s.n, seconds: s.seconds, subtitle: s.subtitle, audio_url: s.audio_url, video_url: s.video_url, provider: 'seedance' } }];"
      }
    },
    {
      "id": "ce2WF02bRenderSh-24",
      "name": "Kling JWT + body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4160,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c = $('Config').first().json.config; const s = $('Keyframe URL').first().json;\n// Kling auth: JWT HS256 signed with your Access Key / Secret Key (store in credential \"CE2 Kling\" as header Authorization: Bearer <JWT>,\n// or let this node sign it when NODE_FUNCTION_ALLOW_BUILTIN=crypto and the keys are set below).\nconst AK = 'SET_KLING_ACCESS_KEY', SK = 'SET_KLING_SECRET_KEY'; let bearer = null;\ntry { const crypto = require('crypto'); const b64 = o => Buffer.from(JSON.stringify(o)).toString('base64url'); const now = Math.floor(Date.now() / 1000);\n  const h = b64({ alg: 'HS256', typ: 'JWT' }), p = b64({ iss: AK, exp: now + 1800, nbf: now - 5 });\n  bearer = h + '.' + p + '.' + crypto.createHmac('sha256', SK).update(h + '.' + p).digest('base64url'); } catch (e) { bearer = null; }\nreturn [{ json: { ...s, tries: 0, bearer, kbody: { model_name: c.kling.model, image: s.keyframe_url, prompt: s.visual_prompt + ', handheld phone video, natural light, realistic', duration: s.seconds > 5 ? '10' : '5', aspect_ratio: '9:16', mode: 'std' } } }];"
      }
    },
    {
      "id": "ce2WF02bRenderSh-25",
      "name": "Kling · submit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
