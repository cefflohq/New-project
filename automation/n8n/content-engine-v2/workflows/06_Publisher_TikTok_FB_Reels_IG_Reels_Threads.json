{
  "id": "ce2WF06Publisher",
  "name": "CEFFLO CE2 · 06 · Publisher (TikTok · FB Reels · IG Reels · Threads)",
  "nodes": [
    {
      "id": "ce2WF06Publisher-1",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -440
      ],
      "parameters": {
        "content": "## 06 · Publisher  (M6)\nEvery 10 min: APPROVED items whose slot is due.\n- **Video** → TikTok (Content Posting API, PULL_FROM_URL, `is_aigc: true`) · IG Reels (container → poll → publish) · FB Reels (start → hosted file → finish)\n- **Text** → Threads (create → publish)\nEach platform is recorded in `publication`; one platform failing does not block the others.\n⚠️ TikTok: app audit required before PUBLIC posting (until then `privacy: SELF_ONLY`), and the video URL domain must be verified in TikTok.\n⚠️ Meta: Instagram/Facebook publishing permissions need Meta app review. Add the platform **AI label** where the API cannot.",
        "width": 680,
        "height": 320,
        "color": 4
      }
    },
    {
      "id": "ce2WF06Publisher-2",
      "name": "Every 10 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "ce2WF06Publisher-3",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ===== CEFFLO Content Engine V2 — CONFIG (edit here; secrets live in Credentials) =====\nreturn [{ json: { config: {\n  tz: 'Asia/Kuala_Lumpur',\n  founderChatId: '1140338735',          // your Telegram user/chat id (numbers)\n  dailyBudgetUsd: 25,                              // generation stops when today's cost reaches this\n  deepseek: { url: 'https://api.deepseek.com/chat/completions', model: 'deepseek-v4-flash', temperature: 0.8 },\n  image: { url: 'SET_IMAGE_API_URL', model: 'SET_IMAGE_MODEL',\n           // Kak Zee references (persona/kak_zee), served by the render worker under /files/persona/kak_zee/\n           personaRefs: ['01_front_portrait.jpg', '05_three_quarter_right.jpg', '07_three_quarter_left.jpg', '02_full_body.jpg'],\n           wardrobe: 'denim-blue cotton tudung bawal, beige linen overshirt over a white t-shirt, black wide-leg trousers, white sneakers, black smartwatch, black shoulder bag' },\n  seedance: { url: 'https://ark.ap-southeast.bytepluses.com/api/v3/contents/generations/tasks', model: 'SET_SEEDANCE_MODEL_ID' },\n  kling: { url: 'https://api-singapore.klingai.com/v1/videos/image2video', model: 'kling-v2-1' },\n  omni: { submitUrl: 'SET_OMNIHUMAN_SUBMIT_URL', pollUrl: 'SET_OMNIHUMAN_POLL_URL' },\n  eleven: { voiceId: 'SET_KAK_ZEE_VOICE_ID', model: 'eleven_v3',\n            settings: { stability: 0.4, similarity_boost: 0.75, style: 0.15, use_speaker_boost: true } },\n  render: { url: 'SET_RENDER_WORKER_URL' },        // e.g. https://render.cefflo.com (render-worker/)\n  screens: {                                       // real CEFFLO screen clips hosted by the render worker\n    vendor_orders: '/files/screens/vendor_orders.mp4', vendor_zones: '/files/screens/vendor_zones.mp4',\n    vendor_plan: '/files/screens/vendor_today.mp4', vendor_riders: '/files/screens/vendor_riders.mp4',\n    vendor_today: '/files/screens/vendor_today.mp4', driver_run: '/files/screens/driver_run.mp4',\n    driver_stops: '/files/screens/driver_stops.mp4', driver_pod: '/files/screens/driver_pod.mp4',\n    customer_tracking: '/files/screens/customer_tracking.mp4', storefront: '/files/screens/storefront.mp4' },\n  slots: { video: ['08:30', '12:30', '20:30'], text: ['10:00', '17:00'] },   // MYT publish times\n  meta: { graph: 'https://graph.facebook.com/v23.0', igUserId: 'SET_IG_USER_ID', pageId: 'SET_FB_PAGE_ID' },\n  threads: { graph: 'https://graph.threads.net/v1.0', userId: 'SET_THREADS_USER_ID' },\n  tiktok: { initUrl: 'https://open.tiktokapis.com/v2/post/publish/video/init/', privacy: 'SELF_ONLY' }, // PUBLIC_TO_EVERYONE after TikTok audit\n} } }];"
      }
    },
    {
      "id": "ce2WF06Publisher-4",
      "name": "Claim due items",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        400,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "update cefflo_ce2.content set status = 'PUBLISHING', updated_at = now()\nwhere id in (select id from cefflo_ce2.content where status = 'APPROVED' and scheduled_at <= now() order by scheduled_at limit 3 for update skip locked)\nreturning id, type, script, media_url",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "CE2_PG",
          "name": "CE2 Postgres"
        }
      }
    },
    {
      "id": "ce2WF06Publisher-5",
      "name": "Video or text?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "Video or text?-0",
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "video",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "video"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "Video or text?-1",
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "text",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "text"
            }
          ]
        },
        "options": {}
      }
    },
