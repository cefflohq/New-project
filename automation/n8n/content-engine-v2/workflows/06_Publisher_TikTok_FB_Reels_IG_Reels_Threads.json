        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ post_info: { title: (($json.script.caption?.tiktok || '') + ' ' + ($json.script.hashtags || []).join(' ')).slice(0, 2100), privacy_level: $('Config').first().json.config.tiktok.privacy, disable_comment: false, is_aigc: true }, source_info: { source: 'PULL_FROM_URL', video_url: $json.media_url } }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CE2_TIKTOK",
          "name": "CE2 TikTok"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
