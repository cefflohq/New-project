{
  "version": 1,
  "default": "deny",
  "freeFormShell": false,
  "dockerSocket": false,
  "productionActions": false,
  "actions": {
    "repo.search": {"roles": ["E1", "E2", "E3", "E4"], "risk": "R0", "enabled": false},
    "repo.read": {"roles": ["E1", "E2", "E3", "E4"], "risk": "R0", "enabled": false},
    "context.validate": {"roles": ["E1"], "risk": "R0", "enabled": false},
    "source.patch": {"roles": ["E2"], "risk": "R1", "enabled": false},
    "source.patch_ui": {"roles": ["E3"], "risk": "R1", "enabled": false},
    "build.run": {"roles": ["E2", "E3"], "risk": "R1", "enabled": false},
    "test.run": {"roles": ["E2"], "risk": "R1", "enabled": false},
    "render.capture": {"roles": ["E3"], "risk": "R1", "enabled": false},
    "visual.compare": {"roles": ["E3"], "risk": "R1", "enabled": false},
    "build.verify": {"roles": ["E4"], "risk": "R1", "enabled": false},
    "test.verify": {"roles": ["E4"], "risk": "R1", "enabled": false},
    "render.verify": {"roles": ["E4"], "risk": "R1", "enabled": false},
    "visual.verify": {"roles": ["E4"], "risk": "R1", "enabled": false},
    "tree.verify": {"roles": ["E4", "E5"], "risk": "R1", "enabled": false},
    "git.commit_verified": {"roles": ["E5"], "risk": "R2", "enabled": false},
    "git.push_task_branch": {"roles": ["E5"], "risk": "R2", "enabled": false},
    "preview.publish_staging": {"roles": ["E5"], "risk": "R2", "enabled": false},
    "preview.verify": {"roles": ["E5"], "risk": "R1", "enabled": false}
  },
  "executionRequirements": {
    "argumentSchema": true,
    "fixedExecutable": true,
    "shellInterpolation": false,
    "validatedWorkingDirectory": true,
    "environmentAllowlist": true,
    "timeout": true,
    "outputLimit": true,
    "auditEvent": true
  }
}
