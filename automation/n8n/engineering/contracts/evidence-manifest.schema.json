{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cefflo.local/schemas/engineering/evidence-manifest.schema.json",
  "title": "CEFFLO Engineering Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "task_pack_hash", "tree_hash", "artifacts", "created_at", "sha256"],
  "properties": {
    "task_id": {"type": "string"},
    "task_pack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tree_hash": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "sha256", "size_bytes", "producer_run_id"],
        "properties": {
          "artifact_id": {"type": "string"},
          "kind": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "mime_type": {"type": ["string", "null"]},
          "producer_run_id": {"type": "string"}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
