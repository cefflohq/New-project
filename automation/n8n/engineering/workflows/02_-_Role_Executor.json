    {
      "parameters": {
        "jsCode": "const i=$input.first().json;\nif(!['E1','E2','E3','E4'].includes(i.role)) throw new Error('MODEL_ROLE_DENIED');\nif(!i.budget_reservation_id||i.budget_status!=='reserved') throw new Error('BUDGET_NOT_RESERVED');\nif(i.role==='E4'&&i.requested_actions?.some(a=>a.startsWith('source.'))) throw new Error('E4_REPAIR_DENIED');\nif(['E3','E4'].includes(i.role)&&i.visual_artifacts?.length!==2) throw new Error('TWO_IMAGE_CONTRACT_REQUIRED');\nif(!['openai-gpt-5.4-mini','deepseek-flash'].includes(i.route_id)) throw new Error('ROUTE_NOT_QUALIFIED');\nreturn [{json:i}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
