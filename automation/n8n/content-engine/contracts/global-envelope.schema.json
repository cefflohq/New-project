{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cefflo.com/contracts/content-engine/global-envelope.schema.json",
  "title": "Cefflo Content Engine Global Envelope",
  "type": "object",
  "required": ["run_id", "task_id", "stage", "status", "market", "language", "objective", "retry_count", "created_at", "updated_at"],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string", "format": "uuid" },
    "campaign_id": { "type": ["string", "null"] },
    "concept_id": { "type": ["string", "null"] },
    "master_concept_id": { "type": ["string", "null"], "pattern": "^CEFFLO-[0-9]{4}-W[0-9]{2}-E[0-9]{3}$" },
    "stage": { "type": "string" },
    "status": { "type": "string" },
    "market": { "type": "string" },
    "language": { "type": "string" },
    "objective": { "type": "string" },
    "target_audience": { "type": ["string", "null"] },
    "priority": { "type": "string" },
    "retry_count": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
